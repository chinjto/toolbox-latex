\ProvidesPackage{cheatsheet-section}

\RequirePackage{core-colors}
\RequirePackage{titlesec}

\titleformat{\section}
{
    \Large
    \bfseries
    \color{accent}
}
{}
{0em}
{}
[
\vspace{-0.3em}
{\color{accent}\rule{\linewidth}{0.8pt}}
]

\titleformat{\subsection}
{
    \normalsize
    \bfseries
    \color{accent!70!black}
}
{}
{0em}
{}

\titlespacing*{\section}
{0pt}{0.8em}{0.4em}

\titlespacing*{\subsection}
{0pt}{1.6em}{0.15em}
